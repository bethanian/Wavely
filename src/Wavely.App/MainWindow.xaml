<Window x:Class="Wavely.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Wavely.App" Title="Wavely">
    <Grid x:Name="Root" KeyDown="OnKeyDown" Background="Transparent">
        <Grid.ChildrenTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></Grid.ChildrenTransitions>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Margin="18,0,150,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE720;" FontSize="16" Foreground="{StaticResource RecordBrush}"/><TextBlock Text="Wavely" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Sound recorder" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="6,0,0,0"/></StackPanel></Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="288"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="16,20,16,12" RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Recordings" Style="{ThemeResource SubtitleTextBlockStyle}"/><Button HorizontalAlignment="Right" Click="OnRefresh" ToolTipService.ToolTip="Refresh library" AutomationProperties.Name="Refresh library" Style="{StaticResource SubtleButtonStyle}"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button></Grid>
                    <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Find a recording" QueryIcon="Find" TextChanged="OnSearchChanged" AutomationProperties.Name="Find a recording"/>
                    <Grid Grid.Row="2">
                        <ListView x:Name="LibraryList" SelectionChanged="OnSelectionChanged" SelectionMode="Single" HorizontalContentAlignment="Stretch" Background="Transparent">
                            <ListView.ItemTemplate><DataTemplate><StackPanel Padding="4,12" Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyLibrary" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"><FontIcon Glyph="&#xE8F1;" FontSize="26" Opacity="0.4"/><TextBlock Text="Your recordings live here" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    </Grid>
                    <Button Grid.Row="3" Click="OnSettings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource SubtleButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock Text="Settings"/></StackPanel></Button>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Padding="36,26,36,28" RowSpacing="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock x:Name="RecordingTitle" Text="Ready when you are" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RecordingSubtitle" Text="A little space for your next idea." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <Button x:Name="ActionsButton" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="Recording actions" IsEnabled="False"><FontIcon Glyph="&#xE712;"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Rename" Icon="Rename" Click="OnRename"/><MenuFlyoutItem Text="Trim a copy" Icon="Trim" Click="OnTrim"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Export MP3" Click="OnExportMp3"/><MenuFlyoutItem Text="Export FLAC" Click="OnExportFlac"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Copy file path" Icon="Copy" Click="OnCopyPath"/><MenuFlyoutItem Text="Open file location" Icon="OpenFile" Click="OnOpenLocation"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Delete" Icon="Delete" Click="OnDelete"/></MenuFlyout></Button.Flyout></Button>
                </Grid>
                <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational"/>
                <Grid Grid.Row="2" MinHeight="150">
                    <local:WaveformView x:Name="Waveform" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" AutomationProperties.Name="Audio waveform"/>
                    <StackPanel x:Name="WaveformHint" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"><TextBlock Text="Every sound starts something." FontSize="16" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="Choose a source below, then press record." FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></StackPanel>
                </Grid>
                <StackPanel Grid.Row="3" Spacing="10">
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" ValueChanged="OnSeek" IsEnabled="False" AutomationProperties.Name="Playback position"/>
                    <Grid><TextBlock x:Name="PositionText" Text="00:00" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="DurationText" Text="00:00" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
                </StackPanel>
                <StackPanel Grid.Row="4" HorizontalAlignment="Center" Spacing="16">
                    <TextBlock x:Name="ElapsedText" Text="00:00.0" FontFamily="Segoe UI Variable Display" FontSize="48" FontWeight="Light" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" AutomationProperties.Name="Elapsed time"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" VerticalAlignment="Center">
                        <Button x:Name="PlayButton" Width="48" Height="48" CornerRadius="24" Click="OnPlay" IsEnabled="False" ToolTipService.ToolTip="Play / pause (Space)" AutomationProperties.Name="Play recording"><FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="18"/></Button>
                        <Button x:Name="RecordButton" Width="72" Height="72" CornerRadius="36" Background="{StaticResource RecordBrush}" Foreground="White" Click="OnRecord" ToolTipService.ToolTip="Record / stop (Ctrl+R)" AutomationProperties.Name="Start recording">
                            <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E44D62"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B93245"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/></Button.Resources>
                            <FontIcon x:Name="RecordIcon" Glyph="&#xE7C8;" FontSize="28"/>
                        </Button>
                        <Button x:Name="PauseButton" Width="48" Height="48" CornerRadius="24" Click="OnPause" IsEnabled="False" ToolTipService.ToolTip="Pause / resume (Space)" AutomationProperties.Name="Pause recording"><FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="18"/></Button>
                    </StackPanel>
                    <TextBlock x:Name="StateText" Text="Start recording · Ctrl+R" HorizontalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="20,14" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE720;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="SourceBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnSourceChanged" AutomationProperties.Name="Audio source"><ComboBoxItem Content="Microphone"/><ComboBoxItem Content="System audio"/><ComboBoxItem Content="Microphone + system audio"/></ComboBox>
                <TextBlock x:Name="FormatText" Grid.Column="2" Text="WAV · 48 kHz · Stereo" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="LevelLabel" Text="INPUT LEVEL" FontSize="9" CharacterSpacing="100" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/><ProgressBar x:Name="LevelBar" Minimum="0" Maximum="1" Value="0" Height="4" Foreground="{StaticResource RecordBrush}" AutomationProperties.Name="Audio input level"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
